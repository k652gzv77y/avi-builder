{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avi-builder-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "AVI_RUNTIME": "cloudflare",
    "REQUIRE_HYPERDRIVE": "true",
    "YCODE_BUILDER_HOSTNAME": "avibuilder.com",
    "YCODE_PUBLIC_SITE_HOSTNAME": "beta.kolboschool.com",
    "YCODE_LEGACY_BUILDER_HOSTNAMES": "ycode.kolboschool.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "avi-builder-staging"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "avi-builder-opennext-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
